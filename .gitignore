# .env is deliberately NOT ignored in this repo. It is the single place every
# agent looks for credentials, and this repo is private by design so the keys
# ship with it. If you fork this pattern into a public repo, put .env back.
data/*
!data/.gitkeep
data/.runs/
.DS_Store
.superpowers/

# n8n workflow exports — contain inline third-party API keys, do not commit
Stream Template*.json
VIBECHECK.md